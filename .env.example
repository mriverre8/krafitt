# Database
# Supabase -> Project Settings -> Database -> Connection string
# Pooler (Transaction, port 6543) for the app:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[AWS_REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) for prisma migrate:
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[AWS_REGION].pooler.supabase.com:5432/postgres"

# Authentication
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# Client IP for the sign-in rate limit (leave empty to trust a single-value X-Forwarded-For).
# A header your proxy sets itself, e.g. x-real-ip or cf-connecting-ip:
AUTH_IP_HEADER=""
# Or, behind a proxy that appends to X-Forwarded-For, its addresses/CIDRs, comma-separated:
AUTH_TRUSTED_PROXIES=""

# Google -> console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
